<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="工具集.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8" MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}"/>
        <ToggleSwitch x:Name="DarkModeToggle" Header="深色模式" OffContent="关" OnContent="开"/>
        <ToggleSwitch x:Name="CompactModeToggle" Header="紧凑模式" OffContent="关" OnContent="开"/>
    </StackPanel>
</Page>
